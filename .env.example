# Base URL of the Payload CMS (e.g. https://cms.example.com or
# https://cms.example.com/api — both accepted).
# When unset (or on CMS failure), the site renders from the bundled
# markdown content in content/ — the backup data source.
VITE_CMS_URL=http://localhost:3000

# ---- CMS backend (cms/) ----
# Copy cms/.env.example to cms/.env and fill in these:
# PAYLOAD_SECRET, DATABASE_URI, CMS_ADMIN_EMAIL, CMS_ADMIN_PASSWORD,
# UPTIMEROBOT_HEARTBEAT_WEBSITE, UPTIMEROBOT_HEARTBEAT_CMS, WEBSITE_URL