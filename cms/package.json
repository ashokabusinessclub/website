{
  "name": "abc-cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "description": "Payload CMS backend for the Ashoka Business Club website",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "seed": "tsx src/seed.ts",
    "export": "tsx src/export-markdown.ts",
    "monitor": "tsx src/heartbeat.ts",
    "migrate": "payload migrate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "dotenv": "^16.4.5",
    "graphql": "^16.8.1",
    "gray-matter": "^4.0.3",
    "next": "16.3.3",
    "node-cron": "^4.2.1",
    "payload": "3.88.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
