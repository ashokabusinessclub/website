# ---- Core ----
PORT=3000
NODE_ENV=development

# Payload admin secret – generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Postgres connection string
DATABASE_URI=postgres://postgres:postgres@localhost:5432/abc_cms

# Comma-separated origins allowed to call the REST API from the browser.
# The website origin (e.g. https://ashokabusinessclub.com) must be listed
# for the frontend's live-fetch to work. When unset, the app uses its built-in
# production website and local-development origins.
# CORS_ORIGINS=https://ashokabusinessclub.com,https://www.ashokabusinessclub.com
# CSRF_ORIGINS=https://ashokabusinessclub.com,https://www.ashokabusinessclub.com

# ---- Seeding (npm run seed) ----
# Created once if no user with this email exists yet.
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=change-me-strong-password

# ---- Export (npm run export) ----
# Point at the running CMS; defaults to localhost.
CMS_API_URL=http://localhost:3000/api

# ---- UptimeRobot heartbeat monitoring (npm run monitor) ----
# Public URL of the website (used to verify the site is actually up).
WEBSITE_URL=https://your-website.example
# Public URL of the CMS health endpoint (used to verify API + DB).
CMS_HEALTH_URL=http://localhost:3000/api/health
# Heartbeat URLs from UptimeRobot (Monitor Type: Heartbeat).
# Leave empty to disable that monitor.
UPTIMEROBOT_HEARTBEAT_WEBSITE=
UPTIMEROBOT_HEARTBEAT_CMS=
# How often the cron runs (minutes, 1-59). Default 5.
HEARTBEAT_INTERVAL_MINUTES=5
